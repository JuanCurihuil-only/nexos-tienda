# ─────────────────────────────────────────────────────────────
#  Configuración de la tienda Nexos
#  1) Copiá este archivo y renombralo a ".env" (sin .example)
#  2) Completá los valores. El archivo .env NUNCA se comparte ni se sube.
# ─────────────────────────────────────────────────────────────

# ── Panel de administración (/admin) ─────────────────────────
# Elegí un usuario y una contraseña larga (mínimo 12 caracteres).
ADMIN_USER=
ADMIN_PASSWORD=

# URL pública del sitio. En tu PC dejalo así; al publicar poné https://nexoscba.com
PUBLIC_SITE_URL=http://localhost:8080

# ── Mercado Pago ─────────────────────────────────────────────
# Mercado Pago Developers → Tus integraciones → (tu aplicación) → Credenciales
# Para PRUEBAS usá el Access Token de las credenciales de prueba.
# Para VENDER DE VERDAD reemplazalo por el Access Token de producción.
MP_ACCESS_TOKEN=

# Clave secreta de los webhooks (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=

# ── Transferencia bancaria ──────────────────────────────────
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_TITULAR=
TRANSFER_BANCO=

# ── Base de datos (Neon) ─────────────────────────────────────
# Neon → tu proyecto → Connect → connection string (sin -pooler).
# No subas este valor. Pegalo solo en .env.
DATABASE_URL=
